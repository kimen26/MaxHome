{
  "permissions": {
    "allow": [
      "Bash(git:*)", "Bash(python:*)", "Bash(node:*)", "Bash(npm:*)", "Bash(npx:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(grep:*)", "Bash(rg:*)", "Bash(find:*)",
      "Bash(head:*)", "Bash(tail:*)", "Bash(sed:*)", "Bash(mkdir:*)", "Bash(cp:*)",
      "Bash(mv:*)", "Bash(echo:*)", "Bash(pwd)", "Bash(gh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-secrets.py\"" },
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-git-large.py\"" }
        ]
      }
    ]
  }
}
